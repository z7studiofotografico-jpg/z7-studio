rules_version = '2';
// Regras do app Z7 Studio. Só entra quem está cadastrado e ativo em "usuarios".
// Donos e administradores veem e mudam tudo. A equipe vê só os módulos marcados no cadastro
// (campo "modulos": funil, lf, rep, agenda, colegios, formaturas, becas). Sem módulos = sem acesso.
// Dinheiro (valores, forma de pagamento, parcelas pagas) e o responsável pela venda só o administrador muda,
// porque a comissão é calculada a partir deles.
// Cole este texto em Firebase → Firestore Database → Regras → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null && request.auth.token.email != null; }
    function email() { return request.auth.token.email.lower(); }
    function dono() { return logado() && email() in ['z7studiofotografico@gmail.com', 'lucianafanjos@gmail.com']; }
    function aprovador() { return logado() && email() in ['lucianafanjos@gmail.com']; }
    function perfilPath() { return /databases/$(database)/documents/usuarios/$(email()); }
    // Cada função lê o cadastro uma vez só (as regras têm limite de expressões por pedido)
    function perfil() { return get(perfilPath()).data; }
    function membro() { return dono() || (logado() && perfil().ativo == true); }
    function admin() { return dono() || adminP(); }
    function adminP() { let p = perfil(); return p.ativo == true && p.papel == 'admin'; }
    function pode(m) { return dono() || podeP(m); }
    function podeP(m) { let p = perfil(); return p.ativo == true && (p.papel == 'admin' || ('modulos' in p && m in p.modulos)); }
    // Carteira: quem não é admin vê os colégios sem responsável e os seus; formandos, só os seus
    // (o campo é lido direto: com .get() e valor padrão o Firebase deixava listar a coleção inteira;
    //  a atualização de dados v4 do app grava "respEmail" em todos os documentos antigos)
    function minhaOuLivre() { return resource.data.respEmail in ['', email()]; }
    function minha() { return resource.data.respEmail == email(); }
    // Campos que mudaram nesta gravação
    function mudou(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasAny(campos); }
    // Responsável: quem não é admin só pode assumir algo sem dono (para si) ou manter como está
    function respOk() {
      return request.resource.data.get('respEmail', '') == resource.data.get('respEmail', '')
        || (resource.data.get('respEmail', '') == '' && request.resource.data.get('respEmail', '') == email());
    }
    function anoAtual(d) { return d.ano >= request.time.year(); }   // Linha de Frente = ensaios do ano atual
    // Agenda: uma leitura do cadastro só (evita o limite de expressões das regras)
    function usaAgenda() { let p = perfil(); return p.ativo == true && (p.papel == 'admin' || ('modulos' in p && ('agenda' in p.modulos || 'colegios' in p.modulos))); }
    // turma (colégio) da carteira de quem grava
    function minhaTurma(instId) {
      return instId != '' && get(/databases/$(database)/documents/instituicoes/$(instId)).data.get('respEmail', '') == email();
    }
    function meuPedido() { return resource.data.get('pedidoEmail', email()) == email(); }

    match /usuarios/{em} { allow read: if membro(); allow write: if admin(); }
    match /config/{id} { allow read: if membro(); allow write: if admin(); }
    // Resumo do Dashboard (gerado de madrugada pelo GitHub ou pelo admin)
    match /resumos/{id} { allow read, write: if admin(); }
    // Aparelhos que recebem notificação: cada um só grava o seu
    match /tokens/{token} {
      allow create, update: if membro() && request.resource.data.email == email();
      allow delete: if admin() || (membro() && resource.data.email == email());
      allow read: if admin();
    }
    // Funil: a equipe cadastra e atende; valor e data de um lead fechado (entram no Dashboard) e apagar, só o admin
    match /leads/{id} {
      allow read: if pode('funil');
      // lead novo da equipe não nasce como venda fechada (senão entraria direto no total do Dashboard)
      allow create: if admin() || (pode('funil') && request.resource.data.get('etapa', '') != 'FECHADO'
        && request.resource.data.get('respEmail', '') in ['', email()]);
      // venda fechada pela equipe entra "a conferir": só o admin marca como conferida
      allow update: if admin() || (pode('funil') && respOk()
        && !(resource.data.get('etapa', '') == 'FECHADO' && mudou(['valor', 'fechadoEm', 'etapa']))
        && (!mudou(['conferido']) || request.resource.data.conferido == false)
        && (request.resource.data.get('etapa', '') != 'FECHADO' || resource.data.get('etapa', '') == 'FECHADO'
          || request.resource.data.get('conferido', true) == false));
      allow delete: if admin();
    }

    match /instituicoes/{id} {
      allow read: if admin() || (pode('colegios') && minhaOuLivre());
      allow create: if admin() || (pode('colegios') && request.resource.data.get('respEmail', email()) == email());
      // valores da turma (kits, contrato) e responsável: só admin (o responsável recebe a comissão da turma)
      allow update: if admin() || (pode('colegios') && minhaOuLivre() && respOk() && !mudou(['kits', 'contratoTurma'])
        && (!mudou(['resp']) || resource.data.get('respEmail', '') == ''));
      // a equipe só apaga colégio que está na própria conta
      allow delete: if admin() || (pode('colegios') && minha());
    }
    // Agenda: um documento por dia (AAAA-MM-DD), um compromisso de colégio por dia.
    // Qualquer um com acesso sugere a data (pendente); só quem aprova confirma; cada um mexe só no seu pedido.
    match /agenda/{dia} {
      allow read: if admin() || usaAgenda();
      allow create: if aprovador() || admin() || (usaAgenda() && request.resource.data.status == 'pendente' && request.resource.data.pedidoEmail == email());
      // cada um mexe só no próprio pedido enquanto está pendente; depois de aprovado, quem pediu só marca que avisou o colégio
      allow update: if aprovador() || admin() || (usaAgenda() && meuPedido() && (
        (resource.data.status != 'confirmado' && request.resource.data.status == 'pendente' && request.resource.data.pedidoEmail == email())
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avisadoWhats', 'avisadoEm'])));
      allow delete: if aprovador() || admin() || (usaAgenda() && resource.data.status != 'confirmado' && meuPedido());
    }
    // Ensaios no estúdio e compromissos: todos da agenda veem; só os donos marcam
    match /ensaios/{id} { allow read: if admin() || usaAgenda(); allow write: if admin(); }
    // Assunto dos compromissos particulares (consulta médica etc.): só admin lê
    match /privado/{id} { allow read, write: if admin(); }
    // Formandos (álbum de formatura e colação de grau)
    match /formandos/{id} {
      allow read: if admin() || ((pode('colegios') || pode('formaturas')) && minha());
      // a equipe cadastra o formando só em turma da própria carteira, e sem parcelas pagas
      allow create: if admin() || ((pode('colegios') || pode('formaturas')) && request.resource.data.get('pagamentos', []).size() == 0
        && request.resource.data.get('pagas', 0) == 0 && request.resource.data.get('respEmail', '') == email()
        && minhaTurma(request.resource.data.get('instId', '')));
      // depois de cadastrado, a equipe só corrige contato e observação;
      // quem ainda não comprou ("semkit"), a equipe pode registrar a venda depois das fotos (sem pagamento)
      allow update: if admin() || ((pode('colegios') || pode('formaturas')) && minha() && (
        !mudou(['valor', 'parcelas', 'pagas', 'pagamentos', 'formaPag', 'contrato', 'kit', 'kitId', 'venda', 'resp', 'respEmail', 'primeiroVenc', 'instId', 'status', 'vendidoEm', 'proxVenc', 'entregueEm', 'devolucao'])
        || (resource.data.get('status', '') == 'semkit' && request.resource.data.get('pagamentos', []).size() == 0
          && request.resource.data.get('status', '') in ['semkit', 'ativo'] && !mudou(['resp', 'respEmail', 'instId', 'entregueEm', 'devolucao']))));
      // a equipe só apaga formando da própria conta e sem nenhuma parcela paga
      allow delete: if admin() || ((pode('colegios') || pode('formaturas')) && minha()
        && resource.data.get('pagas', 0) == 0 && resource.data.get('pagamentos', []).size() == 0);
    }
    // Aluguel de becas
    match /becas/{id} {
      allow read, create: if pode('becas');
      // depois de registrado, a equipe não muda valor nem caução, e o "já pago" só aumenta (receber mais)
      allow update: if admin() || (pode('becas') && !mudou(['valor', 'caucao'])
        && request.resource.data.get('pago', 0) >= resource.data.get('pago', 0));
      allow delete: if admin();
    }
    // Fila de e-mails para os colégios (enviados pelo GitHub com o Gmail do estúdio)
    match /emails/{id} {
      allow create: if aprovador() || admin();
      allow read: if aprovador() || admin();
    }
    // PR: depois de pago, valor, forma de pagamento e responsável só o admin muda
    match /repasse/{id} {
      // (resource == null: aluno que ainda não existe; o "+ Aluno" confere antes de criar)
      allow read: if pode('rep') || (pode('lf') && (resource == null || anoAtual(resource.data)));
      allow update: if admin() || ((pode('rep') || (pode('lf') && anoAtual(resource.data) && anoAtual(request.resource.data)))
        && respOk()
        // a venda entra "a conferir": só o admin marca como conferida (a comissão só conta depois)
        && (!mudou(['conferido']) || request.resource.data.conferido == false)
        && !(resource.data.etapa in ['PAGO', 'ENTREGUE'] && mudou(['valor', 'formaPag', 'pagoEm', 'resp', 'respEmail'])));
      // a equipe inclui aluno à mão (sem planilha): entra na fila ou separado para si, nunca como venda
      allow create: if admin() || ((pode('rep') || (pode('lf') && anoAtual(request.resource.data)))
        && request.resource.data.get('etapa', '') in ['NA FILA', 'INCOMPLETO', 'SEPARADO']
        && request.resource.data.get('respEmail', '') in ['', email()]);
      // venda paga ou entregue não some pela mão da equipe
      allow delete: if admin() || (pode('rep') && !(resource.data.get('etapa', '') in ['PAGO', 'ENTREGUE']));
    }
  }
}
